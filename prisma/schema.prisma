generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  TENANT
}

enum AccountStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  SUSPENDED
  ARCHIVED
}

enum UnitType {
  ONE_BEDROOM
  SHOP
}

enum UnitStatus {
  VACANT
  OCCUPIED
  INACTIVE
}

enum BillStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentCategory {
  RENT
  WATER
}

enum PaymentMethod {
  CASH
  MPESA
  BANK
  OTHER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REVERSED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

model Property {
  id          String      @id @default(cuid())
  name        String      @unique
  address     String?
  floors      Int         @default(6)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  units       Unit[]
  rentBills   RentBill[]
  waterBills  WaterBill[]
  createdById String?
  createdBy   User?       @relation("PropertyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([name])
}

model Unit {
  id          String      @id @default(cuid())
  propertyId  String
  unitNumber  String
  type        UnitType
  floor       Int?
  monthlyRent Decimal     @db.Decimal(12, 2)
  status      UnitStatus  @default(VACANT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  tenant      Tenant?
  rentBills   RentBill[]
  waterBills  WaterBill[]
  payments    Payment[]

  @@unique([propertyId, unitNumber])
  @@index([propertyId])
  @@index([status])
}

model User {
  id                String           @id @default(cuid())
  fullName          String
  email             String?          @unique
  phone             String?          @unique
  passwordHash      String?
  role              UserRole         @default(TENANT)
  accountStatus     AccountStatus    @default(PENDING_APPROVAL)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  lastLoginAt       DateTime?
  lastLogoutAt      DateTime?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  suspendedAt       DateTime?
  archivedAt        DateTime?
  moveOutAt         DateTime?
  approvalNote      String?
  tenant            Tenant?
  loginEvents       LoginEvent[]
  sessions          Session[]
  approvalRequests  ApprovalAction[] @relation("ApprovalRequestUser")
  approvalDecisions ApprovalAction[] @relation("ApprovalDecisionMaker")
  recordedPayments  Payment[]        @relation("PaymentRecordedBy")
  issuedReceipts    Receipt[]        @relation("ReceiptIssuedBy")
  auditEvents       AuditEvent[]
  createdProperties Property[]       @relation("PropertyCreatedBy")
  createdRentBills  RentBill[]       @relation("RentBillCreatedBy")
  createdWaterBills WaterBill[]      @relation("WaterBillCreatedBy")

  @@index([role])
  @@index([accountStatus])
  @@index([createdAt])
}

model Tenant {
  id                   String      @id @default(cuid())
  userId               String      @unique
  unitId               String?     @unique
  requestedUnitNumber  String?
  identificationNumber String?
  moveInAt             DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  user                 User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  unit                 Unit?       @relation(fields: [unitId], references: [id], onDelete: SetNull)
  rentBills            RentBill[]
  waterBills           WaterBill[]
  payments             Payment[]
  receipts             Receipt[]

  @@index([createdAt])
}

model LoginEvent {
  id            String    @id @default(cuid())
  userId        String
  succeeded     Boolean
  loggedInAt    DateTime  @default(now())
  loggedOutAt   DateTime?
  ipAddress     String?
  userAgent     String?
  failureReason String?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedInAt])
  @@index([succeeded, loggedInAt])
}

model ApprovalAction {
  id          String           @id @default(cuid())
  userId      String
  decidedById String
  decision    ApprovalDecision
  note        String?
  decidedAt   DateTime         @default(now())
  user        User             @relation("ApprovalRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy   User             @relation("ApprovalDecisionMaker", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([userId, decidedAt])
  @@index([decidedById, decidedAt])
}

model RentBill {
  id           String     @id @default(cuid())
  propertyId   String
  unitId       String
  tenantId     String
  createdById  String?
  billingMonth DateTime
  amount       Decimal    @db.Decimal(12, 2)
  adjustment   Decimal    @default(0) @db.Decimal(12, 2)
  dueDate      DateTime
  status       BillStatus @default(UNPAID)
  issuedAt     DateTime?
  paidAt       DateTime?
  voidedAt     DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  notes        String?
  property     Property   @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  unit         Unit       @relation(fields: [unitId], references: [id], onDelete: Restrict)
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy    User?      @relation("RentBillCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  payments     Payment[]

  @@unique([tenantId, billingMonth])
  @@index([propertyId, billingMonth])
  @@index([unitId, billingMonth])
  @@index([tenantId, status])
  @@index([dueDate, status])
}

model WaterBill {
  id              String     @id @default(cuid())
  propertyId      String
  unitId          String
  tenantId        String
  createdById     String?
  billingMonth    DateTime
  previousReading Decimal?   @db.Decimal(12, 3)
  currentReading  Decimal?   @db.Decimal(12, 3)
  consumption     Decimal?   @db.Decimal(12, 3)
  rate            Decimal?   @db.Decimal(12, 2)
  amount          Decimal    @db.Decimal(12, 2)
  dueDate         DateTime
  status          BillStatus @default(UNPAID)
  issuedAt        DateTime?
  paidAt          DateTime?
  voidedAt        DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  notes           String?
  property        Property   @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  unit            Unit       @relation(fields: [unitId], references: [id], onDelete: Restrict)
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy       User?      @relation("WaterBillCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  payments        Payment[]

  @@unique([tenantId, billingMonth])
  @@index([propertyId, billingMonth])
  @@index([unitId, billingMonth])
  @@index([tenantId, status])
  @@index([dueDate, status])
}

model Payment {
  id                   String          @id @default(cuid())
  tenantId             String
  unitId               String
  rentBillId           String?
  waterBillId          String?
  recordedById         String?
  category             PaymentCategory
  amount               Decimal         @db.Decimal(12, 2)
  method               PaymentMethod
  transactionReference String?         @unique
  paymentDate          DateTime
  status               PaymentStatus   @default(CONFIRMED)
  confirmedAt          DateTime?
  reversedAt           DateTime?
  reversalReason       String?
  notes                String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  tenant               Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  unit                 Unit            @relation(fields: [unitId], references: [id], onDelete: Restrict)
  rentBill             RentBill?       @relation(fields: [rentBillId], references: [id], onDelete: Restrict)
  waterBill            WaterBill?      @relation(fields: [waterBillId], references: [id], onDelete: Restrict)
  recordedBy           User?           @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  receipt              Receipt?

  @@index([tenantId, paymentDate])
  @@index([unitId, paymentDate])
  @@index([status, paymentDate])
  @@index([category, paymentDate])
}

model Receipt {
  id            String   @id @default(cuid())
  receiptNumber String   @unique
  paymentId     String   @unique
  tenantId      String
  issuedById    String?
  issuedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  issuedBy      User?    @relation("ReceiptIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([tenantId, issuedAt])
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  lastUsedAt DateTime?
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}
